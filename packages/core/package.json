{
  "name": "@mcp-data-agent/core",
  "version": "0.1.0",
  "description": "Core runtime for MCP Data Agent \u2014 auth, RBAC, tenant isolation, schema, and tools. Created by Arslan Habib.",
  "author": {
    "name": "Arslan Habib"
  },
  "creator": "Arslan Habib",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node api.js && tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-data-agent",
    "database",
    "rbac",
    "multi-tenant"
  ]
}
